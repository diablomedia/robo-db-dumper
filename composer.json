{
    "name": "diablomedia/robo-db-dumper",
    "description": "Data dumping commands and tasks for Robo Task Runner",
    "type": "robo-tasks",
    "license": "LGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "DiabloMedia\\Robo\\": "src"
        }
    },
    "require": {
        "diablomedia/robo-mysqldump-php": "^1.1.3",
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.31",
        "phpstan/phpstan": "^2.3.6",
        "rector/rector": "^2.8.5"
    },
    "scripts": {
        "style-check": "php-cs-fixer fix --dry-run -vv",
        "fix-style": "php-cs-fixer fix",
        "phpstan": "phpstan analyse -c phpstan.neon --ansi",
        "rector-check": "rector process --dry-run",
        "rector-fix": "rector process"
    }
}
